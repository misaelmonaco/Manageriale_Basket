NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://basket:basket@postgres:5432/basket?schema=public

# Generate one distinct secret per token type, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The API refuses to start if a secret is missing, too short or left as a placeholder.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_REFRESH_DAYS=30
BCRYPT_SALT_ROUNDS=12

FRONTEND_URL=http://localhost:3000
# Exact origins that may call the API (comma separated).
CORS_ORIGINS=http://localhost:3000
# Hostnames whose subdomains are also accepted (comma separated).
CORS_ALLOWED_HOSTS=courtvisionmanager.pro

# Swagger is served at /docs. Enabled outside production by default.
SWAGGER_ENABLED=true

# --- Email -------------------------------------------------------------------
# Sender address used by every transport. Must belong to a domain you verified
# with the provider, otherwise the emails are rejected.
MAIL_FROM=CourtVision <info@courtvisionmanager.pro>
# resend | smtp. Leave unset to auto-pick: HTTP when RESEND_API_KEY is set,
# SMTP otherwise. Render blocks outbound SMTP ports on free instances, so HTTP
# is the only transport that works there.
MAIL_PROVIDER=
RESEND_API_KEY=

# SMTP transport, used when MAIL_PROVIDER=smtp or no API key is configured.
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@courtvisionmanager.pro
SMTP_PASSWORD=

EMAIL_VERIFICATION_COOLDOWN_MINUTES=5
# true = always require a verified email, false = never block. Unset = strict in production only.
EMAIL_VERIFICATION_REQUIRED=
PASSWORD_RESET_EXPIRY_MINUTES=60

# --- Scheduled jobs ----------------------------------------------------------
# Shared secret for POST /api/v1/payments/reminders/run, sent as x-cron-secret.
# Leave empty to disable the endpoint entirely.
CRON_SECRET=
PAYMENT_REMINDER_DAYS_AHEAD=7
PAYMENT_REMINDER_REPEAT_DAYS=7
PAYMENT_REMINDER_BATCH_SIZE=200
